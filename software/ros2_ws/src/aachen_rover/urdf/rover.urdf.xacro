<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aachen_rover">
  <!-- SI units. Primitive approximation, not a CAD-validated suspension model. -->
  <material name="sand"><color rgba="0.72 0.48 0.25 1"/></material>
  <material name="dark"><color rgba="0.12 0.14 0.16 1"/></material>
  <link name="base_link">
    <inertial><mass value="12"/><inertia ixx="0.37" ixy="0" ixz="0" iyy="0.69" iyz="0" izz="0.98"/></inertial>
    <visual><geometry><box size="0.8 0.55 0.22"/></geometry><material name="sand"/></visual>
    <collision><geometry><box size="0.8 0.55 0.22"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <inertial><mass value="0.8"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.004"/></inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.13" length="0.09"/></geometry><material name="dark"/></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.13" length="0.09"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} -0.12"/><axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0"/>
    </joint>
    <gazebo reference="${name}_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel name="front_left" x="0.30" y="0.34"/>
  <xacro:wheel name="middle_left" x="0" y="0.34"/>
  <xacro:wheel name="rear_left" x="-0.30" y="0.34"/>
  <xacro:wheel name="front_right" x="0.30" y="-0.34"/>
  <xacro:wheel name="middle_right" x="0" y="-0.34"/>
  <xacro:wheel name="rear_right" x="-0.30" y="-0.34"/>
  <link name="lidar_link">
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.06" length="0.06"/></geometry><material name="dark"/></visual>
    <collision><geometry><cylinder radius="0.06" length="0.06"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.22 0 0.24"/></joint>
  <gazebo reference="lidar_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize>
      <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan>
        <range><min>0.15</min><max>20</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint><left_joint>middle_left_joint</left_joint><left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint><right_joint>middle_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.68</wheel_separation><wheel_radius>0.13</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity><min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity><min_angular_velocity>-1.2</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
  </gazebo>
</robot>
