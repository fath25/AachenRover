  <description>Hardware-independent rover interfaces and Gazebo simulation.</description>
  <maintainer email="maintainers@example.com">AachenRover contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
